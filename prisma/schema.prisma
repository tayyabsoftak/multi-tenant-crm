generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

model Organization {
  id         String        @id @default(cuid())
  name       String
  users      User[]
  customers  Customer[]
  notes      Note[]
  activities ActivityLog[]
  deletedAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model User {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  email          String
  name           String
  passwordHash   String?
  role           UserRole      @default(USER)
  assignedCustomers Customer[] @relation("CustomerAssignee")
  notes          Note[]        @relation("AuthorNotes")
  activities     ActivityLog[] @relation("ActorActivities")
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  @@unique([organizationId, email])
  @@index([organizationId, deletedAt])
  @@index([email])
}

model Customer {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  email          String?
  phone          String?
  assigneeId     String?
  assignee       User?         @relation("CustomerAssignee", fields: [assigneeId], references: [id])
  notes          Note[]
  activities     ActivityLog[]
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, deletedAt])
  @@index([organizationId, name])
  @@index([organizationId, email])
}

model Note {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  authorId       String
  author         User         @relation("AuthorNotes", fields: [authorId], references: [id])
  content        String
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, customerId, deletedAt])
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id])
  actorId        String?
  actor          User?        @relation("ActorActivities", fields: [actorId], references: [id])
  action         String
  metadata       Json?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt])
}
